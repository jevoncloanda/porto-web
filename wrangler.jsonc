{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "porto-web",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "cache": {
    "enabled": false
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
