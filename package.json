{
  "name": "porto-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "projects:generate": "node scripts/generate-project-manifest.mjs",
    "predev": "npm run projects:generate",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-next-build.mjs",
    "build": "next build",
    "start": "next start",
    "prelint": "npm run projects:generate",
    "lint": "eslint .",
    "pretypecheck": "npm run projects:generate",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "predev:vinext": "npm run projects:generate",
    "dev:vinext": "vinext dev --port 3001",
    "prebuild:vinext": "npm run projects:generate",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "node scripts/deploy-vinext.mjs"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "framer-motion": "^13.2.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.136.0"
  }
}
